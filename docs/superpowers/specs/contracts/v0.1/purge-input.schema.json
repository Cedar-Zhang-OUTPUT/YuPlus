    "projectPurge": {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "boolean",
          "default": true
        },
        "confirm_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "schedulers_handled": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dry_run": {
                "const": false
              }
            },
            "required": [
              "dry_run"
            ]
          },
          "then": {
            "required": [
              "confirm_id",
              "plan_hash",
              "reason"
            ]
          }
        }
      ]
    },
